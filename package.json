{
  "name": "prestreamer",
  "version": "0.1.0",
  "description": "Presenter + streamer: multi-screen song presentation with live streaming",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:mixer": "node scripts/e2e-mixer.mjs",
    "e2e:stream": "node scripts/e2e-stream.mjs",
    "e2e:video": "node scripts/e2e-video.mjs",
    "e2e": "npm run build && npm run e2e:mixer && npm run e2e:stream && npm run e2e:video",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "author": "AC Dubnica",
  "homepage": "https://github.com/AC-Dubnica/prestreamer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AC-Dubnica/prestreamer.git"
  },
  "build": {
    "appId": "sk.acdubnica.prestreamer",
    "productName": "prestreamer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "prestreamer uses a camera or capture device (such as an ATEM Mini) as a live video source.",
        "NSMicrophoneUsageDescription": "prestreamer receives audio from your mixer's USB interface for the stream."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
